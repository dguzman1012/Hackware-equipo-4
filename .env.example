# Server
PORT=8080                 # http; si existe certs/cert.pem + certs/key.pem también sirve https en HTTPS_PORT
HTTPS_PORT=8443
CERT_DIR=certs

# Reader de escena: gemini (requiere GEMINI_API_KEY) | mock (guion: demo sin cámara ni key) | manual (solo desarrollo: tap en el video)
READER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-robotics-er-2-preview

# ESP32 (solo si la red bloquea broadcast; si no, se descubre solo)
ESP_IP=

# twitter-bot: sin estas 4 credenciales corre en dry-run (loguea, no postea)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
TWEET_INTERVAL_MS=14400000
